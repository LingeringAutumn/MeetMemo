# Non-secret release configuration for MeetMemo code signing and notarization.
# Copy to .env, fill in the two values, then run: chmod 600 .env

# Your Developer ID Application certificate name (from Keychain)
# Run: security find-identity -v -p codesigning | grep "Developer ID Application"
DEVELOPER_ID="developer-id"

# Name of a notarytool credential profile already stored in macOS Keychain.
# Create it interactively so the app-specific password never enters this file or argv:
# xcrun notarytool store-credentials "meetmemo-interview-notary" \
#   --apple-id "you@example.com" --team-id "YOUR_TEAM_ID"
NOTARY_PROFILE="meetmemo-interview-notary"
